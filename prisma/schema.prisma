generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PropertyStatus {
  FOR_SALE
  FOR_RENT
  SOLD
  RENTED
  DRAFT
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum AgentStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id             String    @id @default(cuid())
  siteName       String    @default("Elderz Real Estate")
  tagline        String    @default("Nurture your future home")
  phone          String    @default("Placeholder")
  email          String    @default("Placeholder")
  address        String    @default("Placeholder")
  heroTitle      String    @default("Nurture your future home")
  heroSubtitle   String    @default("Discover houses, apartments, land and commercial properties with confidence.")
  heroImage      String    @default("")
  aboutTitle     String    @default("Property decisions made with confidence.")
  aboutText      String    @default("Elderz Real Estate helps clients discover, buy, rent and manage exceptional property.")
  facebook       String    @default("")
  instagram      String    @default("")
  whatsapp       String    @default("Placeholder")
  logoUrl        String    @default("")
  primaryColor   String    @default("#0B0F0C")
  secondaryColor String    @default("#C8A94B")
  redColor       String    @default("#B42318")
  whiteColor     String    @default("#FFFFFF")
  currencyMode   String    @default("NGN_USD")
  updatedAt      DateTime  @updatedAt
  inquiries      Inquiry[]
}

model Property {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String
  price       Float
  currency    String         @default("NGN")
  status      PropertyStatus @default(FOR_SALE)
  type        String
  location    String
  bedrooms    Int            @default(0)
  bathrooms   Int            @default(0)
  area        Float          @default(0)
  imageUrl    String
  gallery     String[]       @default([])
  featured    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  inquiries   Inquiry[]
}

model Agent {
  id                      String      @id @default(cuid())
  name                    String
  role                    String
  bio                     String
  photoUrl                String
  phone                   String
  email                   String
  whatsapp                String
  licenseNumber           String      @default("")
  licenseType             String      @default("")
  governmentIdPath        String      @default("")
  licenseDocumentPath     String      @default("")
  proofAddressPath        String      @default("")
  selfiePath              String      @default("")
  status                  AgentStatus @default(PENDING)
  emailVerified           Boolean     @default(false)
  phoneVerified           Boolean     @default(false)
  identityVerified        Boolean     @default(false)
  licenseVerified         Boolean     @default(false)
  backgroundCheckVerified Boolean     @default(false)
  verificationNotes       String      @default("")
  reviewedAt              DateTime?
  acceptedAt              DateTime?
  createdAt               DateTime    @default(now())
}

model Service {
  id          String  @id @default(cuid())
  title       String
  description String
  icon        String
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  quote     String
  photoUrl  String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FAQ {
  id        String  @id @default(cuid())
  question  String
  answer    String
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  imageUrl    String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Inquiry {
  id         String        @id @default(cuid())
  name       String
  email      String
  phone      String        @default("")
  message    String
  propertyId String?
  settingsId String?
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
  property   Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  settings   SiteSettings? @relation(fields: [settingsId], references: [id], onDelete: SetNull)
}
